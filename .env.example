# Ethereum mainnet RPC endpoint (server-side only — never prefix with NEXT_PUBLIC_)
RPC_URL=

# Temporary gate: the site asks for this password until Clerk is wired in.
# Username can be anything. Required in production.
SITE_PASSWORD=

# Optional: another Blockscout instance
# BLOCKSCOUT_URL=https://eth.blockscout.com


# Shared storage for tags added on the site: add Upstash Redis from the Vercel Marketplace
# (it sets KV_REST_API_URL and KV_REST_API_TOKEN), or set these yourself.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# TokenLogic API key (Unkey, needs the client.api permission). Ask martin@tokenlogic.xyz.
# With it: supply, prices, utilization, rates and liquidations come from the TokenLogic API.
# Without it: rates still come from TokenLogic's public endpoint; the rest is on-chain.
TOKENLOGIC_API_KEY=

# Aave events: how far back to read (blocks, ~7 200 a day) and the window per eth_getLogs.
# A span the RPC refuses is split in two automatically, so this rarely needs changing.
# AAVE_EVENTS_LOOKBACK_BLOCKS=216000
# LOGS_BLOCK_RANGE=10000
