# Ethereum mainnet RPC endpoint (server-side only — never prefix with NEXT_PUBLIC_)
RPC_URL=

# Temporary gate: the site asks for this password until Clerk is wired in.
# Username can be anything. Required in production.
SITE_PASSWORD=

# Optional: another Blockscout instance
# BLOCKSCOUT_URL=https://eth.blockscout.com

# Source of Aave figures: onchain (default, uses RPC_URL) or tokenlogic (once connected).
# AAVE_SOURCE=onchain

# Shared storage for tags added on the site: add Upstash Redis from the Vercel Marketplace
# (it sets KV_REST_API_URL and KV_REST_API_TOKEN), or set these yourself.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
